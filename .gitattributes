*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

# Les scripts de lancement Windows doivent garder des fins de ligne CRLF :
# cmd.exe interprete mal un .cmd/.bat en LF (labels goto ignores, blocs if (...)
# casses, pause sans effet -> fenetre muette ou qui se ferme).
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Les scripts et ressources Unix restent en LF.
*.sh text eol=lf
*.pem text eol=lf
